{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Host tests + Pebble targets",
      "binaryDir": "${sourceDir}/out",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" }
